# Copy to emulator/.env and change what you need. Every line is optional:
# with no .env at all the device talks to the production cloud.
# .env is gitignored - never commit it.

# --- Cloud -------------------------------------------------------------
# Where the CompostIQ API is. Pick one:
CLOUD_API_URL=https://api.compostiq.win
# CLOUD_API_URL=http://host.docker.internal:8000   # API on your machine, emulator in Docker
# CLOUD_API_URL=http://127.0.0.1:8000              # both on your machine, no Docker
# CLOUD_API_URL=http://127.0.0.1:8001              # the fake cloud: python -m tests.fake_cloud

# Routes on that API. Only change these if the API's routes change.
# PAIRING_PATH=/pairing/redeem
# RECORDS_PATH=/records
# HTTP_TIMEOUT_SECONDS=10

# --- Pile simulation ---------------------------------------------------
# Real seconds between readings.
# READING_INTERVAL_SECONDS=30
# How much faster compost time runs than real time. At 60, each 30 s
# reading moves the pile on 30 minutes, and a whole cycle takes about a day.
# TIME_SCALE=60
# Stage a brand-new pile starts in: 0 Early Mesophilic ... 4 Maturation.
# START_STAGE=0
# AMBIENT_TEMP_C=28
# Fixed seed for repeatable readings (blank = random each start).
# SEED=

# --- Uplink ------------------------------------------------------------
# Most readings sent in one request, and how many to hold while offline
# (the oldest are dropped first).
# UPLOAD_BATCH_MAX=50
# QUEUE_MAX=1000
# After pairing, how often to check whether the device has been set up
# (confirmed, named and given a bin) in the dashboard.
# SETUP_CHECK_SECONDS=10

# --- Identity ----------------------------------------------------------
# Leave DEVICE_UID blank and a fake MAC is made on first start and kept in
# the state file. Set it to pin one.
# DEVICE_UID=
# DEVICE_MODEL=CompostIQ Emulator
# FIRMWARE_VERSION=0.1.0

# --- Running without Docker --------------------------------------------
# Docker sets these three itself.
# DEVICE_HOST=127.0.0.1
# DEVICE_PORT=8080
# STATE_FILE=/absolute/path/device.json          # default: emulator/state/device.json

# Port on your machine when using docker compose.
# EMULATOR_PORT=8080

# LOG_LEVEL=INFO
