# Copy to monitoringSystem/.env for local development. .env is gitignored.
# On the VM these come from the repo-root .env through PM2 instead.

# Where the dashboard's server reaches the API.
API_URL=http://127.0.0.1:8000

# Where devices send their readings. Shown next to the API key when a device
# is registered without pairing. Defaults to https://api.compostiq.win.
PUBLIC_API_URL=http://127.0.0.1:8000

# The public website. "/" on the dashboard (and signing out) goes here.
# Locally, serve website/public with:
#   python -m http.server 8070 --bind 127.0.0.1 --directory website/public
WEBSITE_URL=http://127.0.0.1:8070

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, `python app.py` uses a random key (everyone is signed out on
# every restart) and gunicorn refuses to start.
DASHBOARD_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
