# Copy to .env on the VM and fill in. .env is gitignored - never commit it.
# PM2 (deploy/pm2/ecosystem.config.js) hands each app only its own variables.

# --- API ---
DATABASE_URL=postgresql://compostiq:CHANGE_ME@127.0.0.1:5432/compostiq
# Signs the users' sign-in tokens (JWT). Required, at least 32 characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_EXPIRY_HOURS=8
# How long a device pairing code from the dashboard stays valid, in minutes.
PAIRING_CODE_MINUTES=10

# --- Dashboard ---
# The dashboard calls the API from the server, so use the loopback address:
# it skips NGINX and its per-IP rate limit on /auth/.
API_URL=http://127.0.0.1:8000
# Where devices send their readings, shown with a registered device's API key.
PUBLIC_API_URL=https://api.compostiq.win
# The public website, where "/" on the dashboard and signing out lead.
WEBSITE_URL=https://compostiq.win
# Signs the session cookie. Required on the VM; use a different value from JWT_SECRET.
DASHBOARD_SECRET_KEY=CHANGE_ME_generate_another_long_random_value
